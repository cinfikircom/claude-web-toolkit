{
  "$schema": "seo-os-validation/decision-matrix-v2",
  "site": "golden-seo-test-site",
  "purpose": "Expert decision expectations for the golden site. v2: entries hold ONLY the expert expectation; the scorer derives the SEO-OS side (seoOSAction/correct) dynamically from the graded agent output (detected / actionCorrect / falsePositives / prioritization). Categories: detection accuracy, prioritization correctness, false-positive traps.",
  "legend": {
    "type": "detection (correct if checkId is in output.detected) | prioritization (correct if output.prioritization.correct === true) | false-positive-trap (correct if NO output.falsePositives entry matches any `match` regex, case-insensitive)",
    "severity": "low | medium | high"
  },
  "decisions": [
    {
      "type": "detection",
      "checkId": "seo.single-h1",
      "issue": "Multiple <h1> per page (home/about/services/blog/contact)",
      "expectedAction": "Reduce to one <h1>; convert others to h2/h3",
      "severity": "high"
    },
    {
      "type": "detection",
      "checkId": "seo.meta-description",
      "issue": "Missing meta descriptions (all pages)",
      "expectedAction": "Add unique meta description per page",
      "severity": "high"
    },
    {
      "type": "detection",
      "checkId": "seo.unique-titles",
      "issue": "Duplicate <title> (home == about)",
      "expectedAction": "Make each title unique + descriptive",
      "severity": "high"
    },
    {
      "type": "detection",
      "checkId": "seo.canonical",
      "issue": "Missing rel=canonical (all pages)",
      "expectedAction": "Add absolute canonical per page",
      "severity": "medium"
    },
    {
      "type": "detection",
      "checkId": "seo.internal-linking",
      "issue": "Weak internal linking / orphan pages (about, blog, contact)",
      "expectedAction": "Add nav + contextual cross-links; fix orphans",
      "severity": "medium"
    },
    {
      "type": "detection",
      "checkId": "geo.llms-txt",
      "issue": "No GEO files (llms.txt, ai-agents.json)",
      "expectedAction": "Generate /llms.txt + /ai-agents.json",
      "severity": "high"
    },
    {
      "type": "detection",
      "checkId": "geo.llms-full-txt",
      "issue": "Missing /llms-full.txt",
      "expectedAction": "Generate /llms-full.txt (full-text)",
      "severity": "medium"
    },
    {
      "type": "detection",
      "checkId": "schema.organization",
      "issue": "Organization JSON-LD incomplete + dangling publisher @id",
      "expectedAction": "Complete Organization w/ stable @id; fix @id graph",
      "severity": "high"
    },
    {
      "type": "detection",
      "checkId": "schema.sameas",
      "issue": "No sameAs mappings",
      "expectedAction": "Add sameAs[] to real profiles/Wikidata",
      "severity": "medium"
    },
    {
      "type": "detection",
      "checkId": "schema.service-article",
      "issue": "Service/Article schema not linked to Organization",
      "expectedAction": "Link provider/publisher to Organization @id",
      "severity": "high"
    },
    {
      "type": "detection",
      "checkId": "perf.image-optimization",
      "issue": "Unoptimized hero images (no dims, no next/image) -> LCP+CLS",
      "expectedAction": "next/image AVIF/WebP + dims + preload LCP",
      "severity": "high"
    },
    {
      "type": "detection",
      "checkId": "perf.render-blocking",
      "issue": "Render-blocking 3rd-party script",
      "expectedAction": "defer/async or next/script lazy",
      "severity": "high"
    },
    {
      "type": "detection",
      "checkId": "perf.lazy-loading",
      "issue": "No lazy-loading below the fold",
      "expectedAction": "Lazy-load below-fold media",
      "severity": "medium"
    },
    {
      "type": "prioritization",
      "issue": "Order of operations",
      "expectedAction": "Strategy/business goal first, performance (high risk) staged carefully",
      "severity": "low"
    },
    {
      "type": "false-positive-trap",
      "match": ["framework (change|migration|switch)", "switch(ing)? .*framework", "migrat\\w* .*(astro|gatsby|remix|nuxt|sveltekit)", "(astro|gatsby|remix|nuxt|sveltekit) migration"],
      "issue": "Framework migration suggestion",
      "expectedAction": "Do NOT suggest framework change",
      "severity": "high"
    },
    {
      "type": "false-positive-trap",
      "match": ["\\bAMP\\b", "accelerated mobile pages"],
      "issue": "AMP pages",
      "expectedAction": "Do NOT add AMP (deprecated)",
      "severity": "medium"
    }
  ]
}
